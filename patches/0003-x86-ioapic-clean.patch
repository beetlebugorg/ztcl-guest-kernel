x86/ioapic: skip the scan and clear of a clean I/O APIC

The boot option ioapic_clean tells the kernel that each I/O APIC is in
its reset state, with each pin masked. enable_IO_APIC() then takes
the ExtINT pin from the MP table only, and does not read or clear
the 24 pins. Each register access is an exit to the VMM.

Measured on KVM with the in-kernel I/O APIC: enable_IO_APIC() took
0.96 ms; with ioapic_clean it takes under 0.01 ms.

--- a/arch/x86/kernel/apic/io_apic.c
+++ b/arch/x86/kernel/apic/io_apic.c
@@ -1269,6 +1269,22 @@
 /* Where if anywhere is the i8259 connect in external int mode */
 static struct { int pin, apic; } ioapic_i8259 = { -1, -1 };
 
+/*
+ * "ioapic_clean": the VMM gives each I/O APIC in its reset state, with
+ * each pin masked. The boot then skips the scan for an ExtINT pin and
+ * the clear of each pin. Each access of an I/O APIC register is an exit
+ * to the VMM, and the scan and the clear of 24 pins are about 500
+ * accesses.
+ */
+static bool ioapic_clean __initdata;
+
+static int __init parse_ioapic_clean(char *arg)
+{
+	ioapic_clean = true;
+	return 0;
+}
+early_param("ioapic_clean", parse_ioapic_clean);
+
 void __init enable_IO_APIC(void)
 {
 	int i8259_apic, i8259_pin, apic, pin;
@@ -1279,6 +1295,12 @@
 	if (!nr_legacy_irqs() || !nr_ioapics)
 		return;
 
+	if (ioapic_clean) {
+		ioapic_i8259.pin = find_isa_irq_pin(0, mp_ExtINT);
+		ioapic_i8259.apic = find_isa_irq_apic(0, mp_ExtINT);
+		return;
+	}
+
 	for_each_ioapic_pin(apic, pin) {
 		/* See if any of the pins is in ExtINT mode */
 		struct IO_APIC_route_entry entry = ioapic_read_entry(apic, pin);
