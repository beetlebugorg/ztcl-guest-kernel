virtio_console: kick once for each fill of a receive queue

fill_queue() kicked the device after each buffer, and filled the
whole queue. The queue of the ztcl monitor has 256 entries, so the
probe of the console made 256 exits to the VMM and took 256 pages.
The fill now adds the buffers with no kick, kicks once, and adds
at most fill_queue_max buffers (default 32, a module parameter).

Measured on KVM, 1 CPU, 64 MB (initcall_debug, probe of virtio0):
3.1 ms to 3.5 ms before, 0.4 ms to 0.6 ms after. The kick alone
is about 2.8 ms of it, the cap about 0.2 ms.

--- a/drivers/char/virtio_console.c
+++ b/drivers/char/virtio_console.c
@@ -1295,30 +1295,52 @@
 	port->cons.ws.ws_col = cols;
 }
 
+/* The most receive buffers that fill_queue adds to one queue. */
+static unsigned int fill_queue_max = 32;
+module_param(fill_queue_max, uint, 0444);
+MODULE_PARM_DESC(fill_queue_max, "The most receive buffers of each queue");
+
 static int fill_queue(struct virtqueue *vq, spinlock_t *lock)
 {
 	struct port_buffer *buf;
 	int nr_added_bufs;
 	int ret;
 
+	struct scatterlist sg[1];
+
+	/*
+	 * Add the buffers with no kick, and kick once at the end: a kick is
+	 * an exit to the device, and the queue can have hundreds of
+	 * buffers. Fill at most fill_queue_max buffers, so a large queue
+	 * does not take a page for each of its entries at boot.
+	 */
 	nr_added_bufs = 0;
 	do {
 		buf = alloc_buf(vq->vdev, PAGE_SIZE, 0);
-		if (!buf)
-			return -ENOMEM;
+		if (!buf) {
+			ret = -ENOMEM;
+			break;
+		}
 
+		sg_init_one(sg, buf->buf, buf->size);
 		spin_lock_irq(lock);
-		ret = add_inbuf(vq, buf);
+		ret = virtqueue_add_inbuf(vq, sg, 1, buf, GFP_ATOMIC);
+		if (!ret)
+			ret = vq->num_free;
+		spin_unlock_irq(lock);
 		if (ret < 0) {
-			spin_unlock_irq(lock);
 			free_buf(buf, true);
-			return ret;
+			break;
 		}
 		nr_added_bufs++;
-		spin_unlock_irq(lock);
-	} while (ret > 0);
+	} while (ret > 0 && nr_added_bufs < fill_queue_max);
 
-	return nr_added_bufs;
+	if (nr_added_bufs) {
+		spin_lock_irq(lock);
+		virtqueue_kick(vq);
+		spin_unlock_irq(lock);
+	}
+	return ret < 0 ? ret : nr_added_bufs;
 }
 
 static void send_sigio_to_port(struct port *port)
