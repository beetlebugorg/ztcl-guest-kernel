# The x86-64 boot options of the guest of ztcl::vm, after 30-boot.
# The monitor has one UART, at 0x3f8.
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# The options of the command line that every boot of this guest uses.
# The command line of the VMM comes after them, so it can change them.
# percpu_alloc=page: the first chunk of the per-CPU memory takes only
#   its pages, not a 2 MiB unit that the boot zeroes.
# console=ttynull: with no console= of the VMM, the kernel log goes to
#   no device. Else the 8250 is the console, and each byte of a warning
#   is an exit to the VMM.
# tsc=reliable: no clocksource watchdog and no TSC checks.
# ioapic_clean: see patches/0003.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="percpu_alloc=page console=ttynull tsc=reliable ioapic_clean"
