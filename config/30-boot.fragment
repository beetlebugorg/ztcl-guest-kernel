# The boot time options of the guest of ztcl::vm. Each line has its
# measured gain in TIMES.md.
# 256 legacy PTY pairs make 512 device nodes at boot.
# CONFIG_LEGACY_PTYS is not set
# The guest has no screen or keyboard: no VT, input, or i8042 probe.
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# The agent uses vsock. IPv4 and the loopback device are for the
# programs of the guest, for example the proxy port of the dockyard
# sandbox (127.0.0.1:3128). arm64 tinyconfig has no INET. IPv4 costs
# about 0.2 ms of the boot on KVM (inet_init and sysctl_ipv4_init).
CONFIG_INET=y
# The network device of the NAT of ztcl::vm (ztcl#461), on virtio-mmio
# and PCI, and the packet sockets of a DHCP client in the guest.
# VIRTIO_NET needs NETDEVICES and selects NET_FAILOVER. The menus of the
# Ethernet and WLAN drivers and the PTP clocks stay off.
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_PACKET=y
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_IPV6 is not set
# CONFIG_WIRELESS is not set
# CONFIG_ETHTOOL_NETLINK is not set
# The root is squashfs on dm-verity. LZ4 is for a root that the image
# makes with LZ4.
CONFIG_SQUASHFS_LZ4=y
# The tools disk of dockyard is squashfs with xz (78 MB, against 106 MB
# with gzip). Only a mount of an xz disk uses the code.
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_4K_DEVBLK_SIZE=y
# The console of console=ttynull.
CONFIG_NULL_TTY=y
# Free page reporting (virtio-balloon) for the VM pool, and the DAX
# window of virtio-fs for shares: PROPOSAL.md. With no balloon device
# and no DAX share, they cost about 50 us of the boot on KVM and 90 KB.
CONFIG_VIRTIO_BALLOON=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_FS_DAX=y
CONFIG_FUSE_DAX=y
# madvise(2): the JIT of V8 (node) checks that madvise returns 0, and
# tinyconfig has no madvise. node fails with "Check failed: 0 == ret"
# with no ADVISE_SYSCALLS and runs with it.
CONFIG_ADVISE_SYSCALLS=y
