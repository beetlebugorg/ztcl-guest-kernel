# The boot time options of the guest of ztcl::vm. Each line has its
# measured gain in TIMES.md.
# 256 legacy PTY pairs make 512 device nodes at boot.
# CONFIG_LEGACY_PTYS is not set
# The guest has no screen or keyboard: no VT, input, or i8042 probe.
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# The agent uses vsock. IPv4 and the loopback device are for the
# programs of the guest, for example the proxy port of the dockyard
# sandbox (127.0.0.1:3128). arm64 tinyconfig has no INET. IPv4 costs
# about 0.2 ms of the boot on KVM (inet_init and sysctl_ipv4_init).
CONFIG_INET=y
# The network device of the NAT of ztcl::vm (ztcl#461), on virtio-mmio
# and PCI, and the packet sockets of a DHCP client in the guest.
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_PACKET=y
# CONFIG_IPV6 is not set
# CONFIG_WIRELESS is not set
# CONFIG_ETHTOOL_NETLINK is not set
# The root is squashfs on dm-verity. LZ4 is for a root that the image
# makes with LZ4.
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_4K_DEVBLK_SIZE=y
# The console of console=ttynull.
CONFIG_NULL_TTY=y
